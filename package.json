{
  "name": "tracking-notifier",
  "version": "0.1.0",
  "private": true,
  "description": "Microservicio de tracking multi-tenant: registra cambios de estado de guias y notifica via webhook con reintentos (arquitectura hexagonal).",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "cross-env OPENSSL_ia32cap=~0x20000000 vitest run",
    "test:unit": "cross-env OPENSSL_ia32cap=~0x20000000 vitest run tests/unit",
    "test:integration": "cross-env OPENSSL_ia32cap=~0x20000000 vitest run tests/integration",
    "db:generate": "cross-env OPENSSL_ia32cap=~0x20000000 drizzle-kit generate",
    "db:migrate": "cross-env OPENSSL_ia32cap=~0x20000000 tsx src/infrastructure/persistence/migrate.ts",
    "openapi:export": "cross-env OPENSSL_ia32cap=~0x20000000 tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@types/js-yaml": "^4.0.9",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "js-yaml": "^5.5.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.28.1",
    "openapi-types": "^12.1.3",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
